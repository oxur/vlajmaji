+        }
+        rows.push(row);
+    }
+    rows.push(serde_json::json!({
+        "word":"wikiword", "word_type":"wiki", "definition":"wiki body",
+        "selmaho":"KOhA", "rafsi":"wik"
+    }));
+    rows.push(serde_json::json!({
+        "word":"unknownword", "word_type":"future class", "definition":"future body"
+    }));
+    let raw = serde_json::to_vec(&rows).unwrap();
