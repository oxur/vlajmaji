+    let failure: serde_json::Value = serde_json::from_slice(&missing.stderr).unwrap();
+    assert_eq!(failure["error"]["code"], "io");
+    assert_eq!(fs::read(&release_path).unwrap(), before);
+    fs::remove_dir_all(dir).unwrap();
+}
