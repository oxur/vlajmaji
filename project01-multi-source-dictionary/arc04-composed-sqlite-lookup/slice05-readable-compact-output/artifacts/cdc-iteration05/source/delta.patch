+        match &self.root {
+            Some(bound) if bound != root => Err(CollectionError::InvalidRequest(
+                "reference metadata cache is bound to a different catalogue root".into(),
+            )),
+            Some(_) => Ok(()),
+            None => {
+                self.root = Some(root.to_path_buf());
+                Ok(())
