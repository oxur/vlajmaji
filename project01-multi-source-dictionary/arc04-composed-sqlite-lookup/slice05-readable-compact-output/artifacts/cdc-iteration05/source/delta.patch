+    hits: usize,
+}
+
+impl CollectionReferenceMetadataCache {
+    /// Drops cached descriptors while preserving this cache's native-root binding.
+    pub fn clear(&mut self) {
+        self.entries.clear();
+        self.serialized_weight = 0;
+    }
